<Application x:Class="PcrDesktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style x:Key="AppWindow" TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#24354C"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#172B46"/>
      <Setter Property="BorderBrush" Value="#D5DFEA"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <Grid><Border x:Name="Hover" Background="#172B46" Opacity="0" CornerRadius="6" Margin="-8,-4"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.18"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Margin" Value="0,4,0,10"/>
      <Setter Property="BorderBrush" Value="#CED8E5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#2563EB"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBackground" Background="Transparent" CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
          <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="#64748B"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="#F1F5FB"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBackground" Property="Background" Value="#EAF2FF"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#245DAD"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBackground" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="TabBackground" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#CED8E5"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
    <Style TargetType="Expander"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,6,0,10"/><Setter Property="BorderBrush" Value="#E1E7EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FAFCFF"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="4,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </Application.Resources>
</Application>
