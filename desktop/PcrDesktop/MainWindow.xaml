<Window x:Class="PcrDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="PCR · 任务控制台" Width="1180" Height="820" MinWidth="980" MinHeight="680" Background="#F3F5F8" Closing="Window_Closing">
  <Grid Margin="24" SizeChanged="Layout_SizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel><TextBlock Text="PCR 任务控制台" FontSize="27" FontWeight="SemiBold" Foreground="#172B46"/>
        <TextBlock Text="每日工作有顺序，专项清理按需执行" Margin="0,6,0,0" Foreground="#586578"/></StackPanel>
      <TextBlock x:Name="EnvironmentLabel" Text="本地任务工作台" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#586578"/>
    </DockPanel>
    <TabControl Grid.Row="1" x:Name="Tabs" Background="White" BorderBrush="#DDE3EA">
      <TabItem Header="每日日常">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Border x:Name="DailyHero" Background="#EAF3FF" CornerRadius="8" Padding="16" Margin="0,0,0,14"><DockPanel>
              <Button DockPanel.Dock="Right" Content="开始今日日常" Click="Daily_Click" Background="#245DAD" Foreground="White" Margin="16,0,0,0"/>
              <StackPanel><TextBlock Text="每日日常" FontSize="22" FontWeight="SemiBold" Foreground="#183D70"/><TextBlock Text="按已选配置依次执行；活动任务沿用情报与开关判断。" Margin="0,6,0,0" Foreground="#42556F"/></StackPanel>
            </DockPanel></Border>
            <TextBox x:Name="ConfigBox" Visibility="Collapsed"/>
            <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="加载所选配置" Click="SelectConfig_Click"/><ComboBox x:Name="ConfigPicker" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}" MinWidth="240" Padding="6" Margin="0,0,10,8"/></DockPanel>
            <WrapPanel><Button Content="打开配置…" Click="OpenConfig_Click"/><Button Content="新建空白配置" Click="NewConfig_Click"/><Button Content="保存配置" Click="Save_Click"/><Button Content="另存为…" Click="SaveAs_Click"/><Button x:Name="CompactDailyButton" Content="开始日常" Click="Daily_Click" Visibility="Collapsed" Background="#245DAD" Foreground="White"/>

            </WrapPanel>
          </StackPanel>
          <TextBlock x:Name="CurrentConfigText" Grid.Row="1" Text="请打开配置，或新建空白配置后从可用任务中添加。" Foreground="#586578" Margin="0,2,0,12" TextWrapping="Wrap"/>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="＋ 添加任务" Click="Add_Click" Background="#245DAD" Foreground="White"/><TextBlock x:Name="PlanSummaryText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="MoveUpButton" Content="上移" Click="Up_Click" IsEnabled="False"/><Button x:Name="MoveDownButton" Content="下移" Click="Down_Click" IsEnabled="False"/><Button x:Name="RemoveTaskButton" Content="移除选中项" Click="Remove_Click" IsEnabled="False"/></WrapPanel>
              <DataGrid x:Name="PlanGrid" Background="White" BorderBrush="#DDE3EA" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="38" ColumnHeaderHeight="34" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF3" AlternatingRowBackground="#F8FAFC" SelectionChanged="Plan_SelectionChanged">
                <DataGrid.Resources>
                  <Style x:Key="PlanCellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="Margin" Value="10,0,8,0"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
                  <Style x:Key="PlanHeader" TargetType="DataGridColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,0,8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                  <Style x:Key="PlanCheckHeader" TargetType="DataGridColumnHeader"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns><DataGridTemplateColumn Header="启用" Width="60" MinWidth="60" HeaderStyle="{StaticResource PlanCheckHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="PlanEnabled_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="任务" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" MinWidth="165" ElementStyle="{StaticResource PlanCellText}" HeaderStyle="{StaticResource PlanHeader}"/>
                  <DataGridTextColumn Header="用途" Binding="{Binding CategoryLabel}" IsReadOnly="True" Width="115" MinWidth="115" ElementStyle="{StaticResource PlanCellText}" HeaderStyle="{StaticResource PlanHeader}"/>
                  <DataGridTextColumn Header="参数" Binding="{Binding Args}" IsReadOnly="True" Width="95" MinWidth="80" ElementStyle="{StaticResource PlanCellText}" HeaderStyle="{StaticResource PlanHeader}"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
              <Button x:Name="RunSelectedButton" DockPanel.Dock="Bottom" Content="单独执行选中项" Click="DailySingle_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="EditorTitle" Text="选择一项日常任务" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <ComboBox x:Name="TaskPicker" Visibility="Collapsed"/>
                <TextBlock x:Name="TaskDescription" TextWrapping="Wrap" Foreground="#42556F" Margin="0,0,0,14"/>
                <StackPanel x:Name="ParameterPanel"/>
                <TextBlock x:Name="ParameterErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8,0,4"/>
                <TextBlock Text="参数修改会应用到当前列表；点击顶部「保存配置」写入文件。添加其他任务请使用左侧「＋ 添加任务」。" TextWrapping="Wrap" Foreground="#586578" Margin="0,8,0,12"/>
              </StackPanel></ScrollViewer>
            </DockPanel>
          </Grid>
          <TextBlock Grid.Row="3" Text="日常按列表顺序运行；剧情清理、地下城首通等耗时工作请前往「按需专项」。" Foreground="#586578" Margin="0,12,0,0"/>
        </Grid>
      </TabItem>
      <TabItem Header="按需专项">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="SpecialHero" Background="#FFF3E4" CornerRadius="8" Padding="16" Margin="0,0,0,16"><DockPanel>
            <Button DockPanel.Dock="Right" Content="刷新专项任务" Click="Catalog_Click" Margin="12,0,0,0"/>
            <StackPanel><TextBlock Text="集中处理一件事" FontSize="22" FontWeight="SemiBold" Foreground="#79511E"/>
            <TextBlock Text="适合首通、积累清理与培养等专项工作。按当前游戏条件执行，可能需要较长时间。" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#755E44"/></StackPanel>
          </DockPanel></Border>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="CatalogList" SelectionChanged="Catalog_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="#E2E7ED">
              <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,12"><TextBlock Text="{Binding Label}" FontSize="15" TextWrapping="Wrap"/><TextBlock Text="按需执行 · 独立于日常列表" Foreground="#778495" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Column="2">
              <Border DockPanel.Dock="Bottom" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0"><StackPanel>
                <Button Content="执行本次专项" Click="Single_Click" Background="#9A6324" Foreground="White" HorizontalAlignment="Left" Padding="28,10"/>
                <TextBlock Text="仅执行所选专项；本次参数与选项不会加入或改写日常配置。" TextWrapping="Wrap" Foreground="#586578"/>
              </StackPanel></Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="CatalogTitle" Text="选择要处理的专项" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,16" TextWrapping="Wrap"/>
                <TextBlock x:Name="CatalogDescription" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="#42556F" Margin="0,0,0,18"/>
                <StackPanel x:Name="SpecialParameterPanel"/>
                <Expander Header="本次运行选项" IsExpanded="True" Margin="0,12,0,0"><StackPanel x:Name="SpecialOptionsPanel"/></Expander>
              </StackPanel></ScrollViewer>
            </DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="日常选项">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="日常配置的运行选项" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="这些选项随日常配置保存；专项的本次运行选项在「按需专项」中独立调整。" Foreground="#586578" Margin="0,10,0,18"/>
          <StackPanel x:Name="OptionsPanel"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="RunTab" Header="运行状态">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock x:Name="RunScopeText" Text="等待选择日常或专项" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button x:Name="PauseButton" IsEnabled="False" Content="暂停" Click="Pause_Click"/><Button x:Name="ResumeButton" IsEnabled="False" Content="恢复" Click="Resume_Click"/><Button x:Name="StopButton" IsEnabled="False" Foreground="#B42318" Content="停止" Click="Stop_Click"/><Button x:Name="SnapshotButton" IsEnabled="False" Content="保存现场" Click="Snapshot_Click"/><Button Content="重新检查运行" Click="RefreshRun_Click"/><Button Content="打开运行目录" Click="OpenRun_Click"/></WrapPanel></StackPanel>
          <Border Grid.Row="1" Background="#EEF4FC" Padding="16" Margin="0,4,0,14"><TextBlock x:Name="StatusText" Text="尚未启动任务" FontSize="15" TextWrapping="Wrap"/></Border>
          <TextBox Grid.Row="2" x:Name="LiveLog" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#142034" Foreground="#DFE8F5"/>
        </Grid>
      </TabItem>
      <TabItem Header="运行记录">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel><Button Content="刷新记录" Click="History_Click"/><Button Content="打开记录目录" Click="OpenHistory_Click"/></WrapPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid><ListBox x:Name="HistoryList" SelectionChanged="History_SelectionChanged"/>
              <TextBlock Text="暂无运行记录&#10;运行任务后，可在这里查看结果与证据。" TextWrapping="Wrap" Margin="20" Foreground="#78869A" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=HistoryList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <TextBox Grid.Column="2" x:Name="HistoryText" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="环境设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="本地 Python 工程" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="工程目录" Margin="0,12,0,0"/><DockPanel><Button Content="选择…" DockPanel.Dock="Right" Click="Browse_Click"/><TextBox x:Name="WorkspaceBox"/></DockPanel>
          <TextBlock Text="运行用 Python（例如 工程\.venv\Scripts\python.exe）"/><TextBox x:Name="PythonBox"/>
          <TextBlock x:Name="EmulatorLabel" Text="设备连接：ADB" Margin="0,8,0,10"/>
          <Button Content="重新配置工程 / 设备…" Click="Setup_Click" HorizontalAlignment="Left"/>
          <TextBlock Text="创建环境使用的 Python 3.12+ 路径或命令"/><TextBox x:Name="BootstrapBox"/>
          <WrapPanel><Button Content="下载 Python（官网）" Click="PythonDownload_Click"/><Button Content="检测 Python" Click="DetectPython_Click"/></WrapPanel>
          <TextBlock Text="没有 Python 时先从官网安装（建议 3.12 x64，勾选 PATH），然后检测并安装依赖。依赖下载需要联网。" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="保存环境设置" Click="Settings_Click"/><Button Content="创建环境 / 安装依赖" Click="Install_Click"/></WrapPanel>
          <Expander Header="源码版本与更新" IsExpanded="False" Margin="0,18,0,0"><StackPanel>
          <TextBlock Text="Git 仓库地址"/><TextBox x:Name="RepositoryBox"/>
          <TextBlock Text="分支"/><TextBox x:Name="BranchBox"/>
          <TextBlock Text="新目录下载范围"/>
          <ComboBox x:Name="DownloadScopeBox" SelectedIndex="0" Margin="0,5,0,8">
            <ComboBoxItem Content="仅核心运行文件（默认）：Python 核心、图片、默认选项和依赖清单"/>
            <ComboBoxItem Content="完整仓库：包含脚本工具、文档、测试和 GUI 源码"/>
          </ComboBox>
          <TextBlock Text="此选项仅用于新下载；更新已有工程会保留原下载范围。" Foreground="#586578"/>
          <WrapPanel><Button Content="下载到新目录…" Click="Clone_Click"/><Button Content="检查源码版本" Click="Version_Click"/><Button Content="更新源码（仅快进）" Click="Update_Click"/></WrapPanel>
          <TextBlock Text="更新前先停止任务；存在本地源码改动时拒绝更新。配置与缓存保留。首次运行需安装 Python 和 Git。" TextWrapping="Wrap" Foreground="#586578"/>
          </StackPanel></Expander><Expander Header="配置数据预览（只读）" IsExpanded="False"><StackPanel>
          <TextBlock Text="在配置选项页编辑；以下为最近加载或保存的数据。" TextWrapping="Wrap" Foreground="#586578"/>
          <TextBox x:Name="OptionsBox" IsReadOnly="True" Height="290" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
          </StackPanel></Expander>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" x:Name="MessageText" Text="就绪" Foreground="#586578" Margin="0,14,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
