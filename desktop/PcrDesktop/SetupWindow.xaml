<Window x:Class="PcrDesktop.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="PCR · 首次使用设置" Width="790" Height="760" MinWidth="720" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F3F5F8" Closing="Setup_Closing">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="准备首次运行" FontSize="26" FontWeight="SemiBold" Foreground="#172B46"/>
      <TextBlock Text="选择项目保存位置，连接雷电模拟器或手机，然后准备运行环境。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#586578"/></StackPanel>
    <ScrollViewer x:Name="SetupFields" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="1  保存项目的位置" FontSize="18" FontWeight="SemiBold"/>
      <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="选择目录…" Click="ProjectBrowse_Click"/><TextBox x:Name="ProjectPath" TextChanged="Project_Changed"/></DockPanel>
      <TextBlock x:Name="ProjectStatus" TextWrapping="Wrap" Foreground="#42556F" Margin="0,0,0,8"/>
      <StackPanel x:Name="DownloadPanel" Visibility="Collapsed">
        <Expander Header="下载选项（通常无需修改）"><StackPanel>
          <TextBox x:Name="Repository" ToolTip="Git 仓库地址"/>
          <ComboBox x:Name="DownloadScope" SelectedIndex="0" Margin="0,5,0,8">
            <ComboBoxItem Content="仅核心运行文件（推荐日常使用）"/>
            <ComboBoxItem Content="完整仓库（开发、命令行或交给 Agent）"/>
          </ComboBox>
          <DockPanel><Button DockPanel.Dock="Right" x:Name="DownloadButton" Content="仅下载项目" Click="Download_Click"/><TextBox x:Name="Branch" ToolTip="分支"/></DockPanel>
        </StackPanel></Expander>
      </StackPanel>
      <TextBlock Text="2  连接雷电模拟器或手机" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="雷电模拟器：选择安装目录（包含 ldconsole.exe），把模拟器分辨率设为 960×540，然后启动游戏。" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <DockPanel><Button DockPanel.Dock="Right" Content="选择雷电模拟器目录…" Click="EmulatorBrowse_Click"/><TextBox x:Name="EmulatorPath"/></DockPanel>
      <TextBlock Text="手机：雷电模拟器目录留空，在下方准备 ADB。连接成功只代表设备在线，手机布局仍需验证。" TextWrapping="Wrap" Foreground="#586578"/>
      <Expander Header="手机 / ADB 设置" Margin="0,8,0,0"><StackPanel>
        <TextBlock Text="开启手机的开发者选项和 USB 调试，用数据线连接并允许此电脑调试。" TextWrapping="Wrap"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择 adb.exe…" Click="AdbBrowse_Click"/><TextBox x:Name="AdbPath" ToolTip="已有 ADB 可填写完整路径或 adb（PATH）"/></DockPanel>
        <WrapPanel><Button Content="阅读 Android SDK 许可" Click="AdbLicense_Click"/><CheckBox x:Name="AdbLicense" Content="我已阅读并同意许可协议" VerticalAlignment="Center"/></WrapPanel>
        <Button Content="下载 ADB 工具" Click="InstallAdb_Click" HorizontalAlignment="Left"/>
        <TextBlock Text="ADB 设备序列号（检查连接后可选择；只有一个已授权设备可留空）" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <ComboBox x:Name="AdbSerial" IsEditable="True" Margin="0,5,0,8"/>
      </StackPanel></Expander>
      <TextBlock Text="3  准备运行环境" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="点击下方“一键准备运行环境”。首次需要联网，可能耗时数分钟；失败后可重试。完成后点击“检查设备连接”。" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Button Content="检查设备连接" Click="CheckDevice_Click" HorizontalAlignment="Left"/>
      <Expander Header="已有 Python / 手动设置"><StackPanel>
        <TextBlock Text="运行用 Python（默认工程中的 .venv）"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择 Python…" Click="PythonBrowse_Click"/><TextBox x:Name="PythonPath"/></DockPanel>
        <TextBlock Text="创建 .venv 用的 Python（留空可自动检测或下载）"/>
        <TextBox x:Name="Bootstrap"/>
        <WrapPanel><Button Content="下载 Python（官网）" Click="PythonDownload_Click"/><Button Content="检测 Python" Click="DetectPython_Click"/></WrapPanel>
      </StackPanel></Expander>
      <Expander Header="准备过程与错误详情" Margin="0,8,0,0"><TextBox x:Name="SetupLog" IsReadOnly="True" Height="140" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></Expander>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="ProgressText" TextWrapping="Wrap" MaxHeight="70" Foreground="#42556F" ToolTip="完整输出见上方“准备过程与错误详情”"/>
      <WrapPanel Margin="0,8,0,0"><Button x:Name="PrepareButton" Content="一键准备运行环境" Click="Install_Click" Background="#DBEAFE"/>
        <Button x:Name="FinishButton" Content="进入任务控制台（可稍后准备）" Click="Finish_Click"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
